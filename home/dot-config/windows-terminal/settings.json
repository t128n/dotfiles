            "green": "#33B1FF",
            "name": "Oxocarbon Dark",
            "purple": "#BE95FF",
            "red": "#3DDBD9",
            "selectionBackground": "#393939",
            "white": "#F2F4F8",
            "yellow": "#EE5396"
        },
        {
            "background": "#F2F4F8",
            "black": "#F2F4F8",
            "blue": "#42BE65",
            "brightBlack": "#161616",
            "brightBlue": "#42BE65",
            "brightCyan": "#673AB7",
            "brightGreen": "#0F62FE",
            "brightPurple": "#BE95FF",
            "brightRed": "#FF7EB6",
            "brightWhite": "#525252",
            "brightYellow": "#FF6F00",
            "cursorColor": "#393939",
            "cyan": "#673AB7",
            "foreground": "#393939",
            "green": "#0F62FE",
