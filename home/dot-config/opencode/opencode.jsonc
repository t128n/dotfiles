{
  "$schema": "https://opencode.ai/config.json",

  // Tool versions are managed by mise.
  "update": "disable",

  // Use project-detected formatters after file modifications.
  "formatter": true,

  // Write compaction summaries in the background so they do not pause the session.
  "experimental": {
    "background_compaction": true,
  },

  // Browser automation runs through the browse MCP server, never an in-app browser.
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": ["browse", "mcp"],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update",
        },
      },
    },
  },

  // Security and permissions policy (last match wins, no match = ask).
  "permissions": [
    // External directory access: ask by default, but allow trusted roots.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/Workspace/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.opencode/plan/*", "effect": "allow" },
    // Skill instructions and their references/ scripts are trusted assets
    // loaded by the skill tool; never prompt to read them.
    { "action": "external_directory", "resource": "~/.agents/skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/skills/*", "effect": "allow" },
    // Temporary directories on Windows, Linux, and macOS.
    { "action": "external_directory", "resource": "~/AppData/Local/Temp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/folders/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/folders/*", "effect": "allow" },

    // Web access: deny the built-in tools so agents use the browse MCP server
    // (tools.browse.*) instead of the desktop in-app browser or webfetch.
    // A browser deny removes the desktop browser catalog entirely.
    { "action": "browser", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },

    // Sensitive files: deny reading environment secrets, allow examples.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.*.example", "effect": "allow" },

    // Shell safety: require approval for pushes and hard resets,
    // including bare commands and `git -C` forms.
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git * push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git * reset --hard *", "effect": "ask" },
  ],
}
